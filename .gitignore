# Ambiente virtual
.venv/

# Videos fuente: pesados, no se versionan
videos/
*.MOV
*.mov
*.mp4

# Fotogramas de cada corrida: regenerables desde el video
runs/*/frames/
runs/*/samples/

# Corrida vieja del layout de un solo video, conservada aparte hasta decidir
old_data/

# Se versionan: calib/ (receta y plantillas), runs/*/config.json y runs/*/out/

